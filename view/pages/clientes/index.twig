{% extends "layout/layoutMaster.twig" %}

{% block title %}{{ titulo }}{% endblock %}

{% block body %}

<div class="content-body">
    
    <!-- row -->
    <div class="container-fluid">
        <div class="page-titles">
            <div class="d-flex flex-wrap align-items-center justify-content-between">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ DOMAIN }}">Home</a></li>
                    <li class="breadcrumb-item active"><a href="javascript:void(0)">{{ titulo }}</a></li>
                </ol>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="card mb-0">
                    <div class="card-body py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Total de usuários</div>
                            <div class="fs-4 fw-bold">{{ contadores.total|number_format(0, ',', '.') }}</div>
                        </div>
                        <span class="badge bg-primary rounded-pill px-3 py-2">{{ contadores.total|number_format(0, ',', '.') }}</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="card mb-0">
                    <div class="card-body py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Usuários inativos</div>
                            <div class="fs-4 fw-bold">{{ contadores.inativos|number_format(0, ',', '.') }}</div>
                        </div>
                        <span class="badge bg-secondary rounded-pill px-3 py-2">{{ contadores.inativos|number_format(0, ',', '.') }}</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card mb-0">
                    <div class="card-body py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small">Usuários banidos</div>
                            <div class="fs-4 fw-bold">{{ contadores.banidos|number_format(0, ',', '.') }}</div>
                        </div>
                        <span class="badge bg-danger rounded-pill px-3 py-2">{{ contadores.banidos|number_format(0, ',', '.') }}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <form method="get" action="{{ DOMAIN }}/clientes" class="row g-2 align-items-end mb-4">
                    <div class="col-md-4 col-lg-3">
                        <label class="form-label">Buscar cliente</label>
                        <input type="text" name="search" class="form-control" placeholder="Nome, e-mail, CPF ou telefone" value="{{ filters.search }}">
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-control">
                            <option value="">Todos</option>
                            <option value="Ativo" {{ filters.status == 'Ativo' ? 'selected' : '' }}>Ativo</option>
                            <option value="Inativo" {{ filters.status == 'Inativo' ? 'selected' : '' }}>Inativo</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label">Banimento</label>
                        <select name="banido" class="form-control">
                            <option value="">Todos</option>
                            <option value="1" {{ filters.banido == '1' ? 'selected' : '' }}>Banidos</option>
                            <option value="0" {{ filters.banido == '0' ? 'selected' : '' }}>Não banidos</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-search me-1"></i> Filtrar</button>
                    </div>
                    <input type="hidden" name="order" value="{{ filters.order }}">
                    <input type="hidden" name="dir" value="{{ filters.dir }}">
                    {% if filters.search or filters.status or filters.banido %}
                    <div class="col-auto">
                        <a href="{{ DOMAIN }}/clientes" class="btn btn-outline-secondary">Limpar</a>
                    </div>
                    {% endif %}
                    <div class="col-12">
                        <small>{{ total }} cliente(s) encontrado(s) com o filtro atual.</small>
                    </div>
                </form>

                {% set qs = '' %}
                {% if filters.search %}{% set qs = qs ~ '&search=' ~ filters.search|url_encode %}{% endif %}
                {% if filters.status %}{% set qs = qs ~ '&status=' ~ filters.status|url_encode %}{% endif %}
                {% if filters.banido != '' %}{% set qs = qs ~ '&banido=' ~ filters.banido|url_encode %}{% endif %}
                {% set qs_base = qs %}
                {% if filters.order %}{% set qs = qs ~ '&order=' ~ filters.order|url_encode %}{% endif %}
                {% if filters.dir %}{% set qs = qs ~ '&dir=' ~ filters.dir|url_encode %}{% endif %}

                {% macro sort_link(label, campo, filters, qs_base, align) %}
                    {% set ativa = filters.order == campo %}
                    {% set proxima = (ativa and filters.dir == 'ASC') ? 'DESC' : 'ASC' %}
                    {% set icone = ativa ? (filters.dir == 'ASC' ? 'fa-sort-up' : 'fa-sort-down') : 'fa-sort' %}
                    <a href="?page=1{{ qs_base }}&order={{ campo }}&dir={{ proxima }}" class="text-dark text-decoration-none {{ align }}">
                        {{ label }} <i class="fa {{ icone }} ms-1"></i>
                    </a>
                {% endmacro %}
                {% import _self as ui %}

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr role="row">
                                <th width="50"></th>
                                <th>{{ ui.sort_link('Nome', 'nome', filters, qs_base, '') }}</th>
                                <th>Email</th>
                                <th>CPF</th>
                                <th>Telefone</th>
                                <th class="text-center">{{ ui.sort_link('Qtd. Reserva', 'qtd_reservas', filters, qs_base, '') }}</th>
                                <th>Status</th>
                                <th class="text-end">{{ ui.sort_link('Data', 'data', filters, qs_base, '') }}</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for cliente in clientes %}
                            <tr class="cliente-{{ cliente.id }}">
                                <td width="50">#{{ offset + loop.index }}</td>
                                <td>{{ cliente.nome }}</td>
                                <td>{{ cliente.email }}</td>
                                <td>{{ cliente.cpf }}</td>
                                <td>{{ cliente.telefone }}</td>
                                <td class="text-center">
                                    {% if cliente.qtd_reservas > 0 %}
                                        <span class="badge bg-primary">{{ cliente.qtd_reservas }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary">0</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if cliente.status == 'Ativo' %}
                                        <span class="badge bg-success">Ativo</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ cliente.status|default('Inativo') }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-end text-nowrap">{{ cliente.data|date("d-m-Y \\a\\s H:i", "America/Sao_Paulo") }}</td>
                                <td class="text-end acoes-cliente-{{ cliente.id }}">
                                    {% if cliente.banido > 0 %}
                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                onclick="desbanirCliente({{ cliente.id }}, '{{ cliente.nome|e('js') }}')"
                                                data-bs-toggle="tooltip"
                                                data-bs-title="Remover banimento">
                                            <i class="fa fa-unlock"></i> Desbanir
                                        </button>
                                    {% else %}
                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                onclick="banirCliente({{ cliente.id }}, '{{ cliente.nome|e('js') }}')"
                                                data-bs-toggle="tooltip"
                                                data-bs-title="Banir cliente">
                                            <i class="fa fa-ban"></i> Banir
                                        </button>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                            {% if clientes|length == 0 %}
                            <tr>
                                <td colspan="9" class="text-center py-4">Nenhum cliente encontrado.</td>
                            </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>

                {% if pagination %}
                <nav aria-label="Paginação" class="mt-4">
                    <ul class="pagination pagination-circle justify-content-center">
                        {% if pagination.before %}
                            {% for p in pagination.before %}
                            <li class="page-item"><a class="page-link" href="?page={{ p.number }}{{ qs }}">{{ p.number }}</a></li>
                            {% endfor %}
                        {% endif %}
                        {% if pagination.beforeMiddle %}
                            {% for p in pagination.beforeMiddle %}
                            <li class="page-item"><a class="page-link" href="?page={{ p.number }}{{ qs }}">{{ p.number }}</a></li>
                            {% endfor %}
                        {% endif %}
                        {% if pagination.actual %}
                        <li class="page-item active"><a class="page-link" href="#">{{ pagination.actual }}</a></li>
                        {% endif %}
                        {% if pagination.lateMiddle %}
                            {% for p in pagination.lateMiddle %}
                            <li class="page-item"><a class="page-link" href="?page={{ p.number }}{{ qs }}">{{ p.number }}</a></li>
                            {% endfor %}
                        {% endif %}
                        {% if pagination.late %}
                            {% for p in pagination.late %}
                            <li class="page-item"><a class="page-link" href="?page={{ p.number }}{{ qs }}">{{ p.number }}</a></li>
                            {% endfor %}
                        {% endif %}
                    </ul>
                </nav>
                {% endif %}
            </div>
        </div>

    </div>
</div>

<script>
function atualizarLinhaCliente(id, banido) {
    var acoes = document.querySelector('.acoes-cliente-' + id);

    if (banido) {
        if (acoes) acoes.innerHTML = '<button type="button" class="btn btn-success btn-sm" onclick="desbanirCliente(' + id + ', \'\')" title="Remover banimento"><i class="fa fa-unlock"></i> Desbanir</button>';
    } else {
        if (acoes) acoes.innerHTML = '<button type="button" class="btn btn-danger btn-sm" onclick="banirCliente(' + id + ', \'\')" title="Banir cliente"><i class="fa fa-ban"></i> Banir</button>';
    }
}

function enviarAcaoCliente(url, id) {
    return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'id=' + encodeURIComponent(id)
    }).then(function (r) { return r.json(); });
}

function banirCliente(id, nome) {
    Swal.fire({
        icon: 'warning',
        title: 'Banir cliente?',
        html: 'O cliente <strong>' + (nome || '') + '</strong> não poderá mais fazer login, criar novas contas ou reservas — do mesmo celular, CPF, e-mail ou IP.',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Sim, banir',
        cancelButtonText: 'Cancelar'
    }).then(function (res) {
        if (!res.isConfirmed) return;
        enviarAcaoCliente('{{ DOMAIN }}/clientes/banir', id).then(function (data) {
            if (data.success) {
                atualizarLinhaCliente(id, true);
                Swal.fire({ icon: 'success', title: 'Banido!', text: data.message, timer: 2000, showConfirmButton: false });
            } else {
                Swal.fire({ icon: 'error', title: 'Erro!', text: data.message });
            }
        }).catch(function () {
            Swal.fire({ icon: 'error', title: 'Erro!', text: 'Ocorreu um erro ao banir o cliente.' });
        });
    });
}

function desbanirCliente(id, nome) {
    Swal.fire({
        icon: 'question',
        title: 'Remover banimento?',
        html: 'O cliente <strong>' + (nome || '') + '</strong> voltará a poder usar o aplicativo normalmente.',
        showCancelButton: true,
        confirmButtonText: 'Sim, remover',
        cancelButtonText: 'Cancelar'
    }).then(function (res) {
        if (!res.isConfirmed) return;
        enviarAcaoCliente('{{ DOMAIN }}/clientes/desbanir', id).then(function (data) {
            if (data.success) {
                atualizarLinhaCliente(id, false);
                Swal.fire({ icon: 'success', title: 'Pronto!', text: data.message, timer: 2000, showConfirmButton: false });
            } else {
                Swal.fire({ icon: 'error', title: 'Erro!', text: data.message });
            }
        }).catch(function () {
            Swal.fire({ icon: 'error', title: 'Erro!', text: 'Ocorreu um erro ao remover o banimento.' });
        });
    });
}
</script>

{% endblock %}
